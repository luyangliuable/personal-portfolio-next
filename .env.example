# Example environment variables for local development and CI builds.
# Do not put real secrets in this file.

# Local Rust backend API used by the frontend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# Required during Next.js build because API routes import the MongoDB client.
# Replace with your own local or secret-provided connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/example

# Set to true only when debugging Auth.js locally.
AUTH_DEBUG=false
