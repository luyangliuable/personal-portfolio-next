# Example environment variables for local development and CI builds.
# Do not put real secrets in this file.

# Required during Next.js build because API routes import the MongoDB client.
# Replace with your own local or secret-provided connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/example

# Ported Rust backend configuration (all optional locally).
# MONGOURI is the name the Rust service uses for the same connection.
MONGOURI=mongodb://127.0.0.1:27017
ENVIRONMENT=development

# Local file stores for markdown posts, notes and images.
MARKDOWN_POSTS_STORE_LOCATION=./data/markdown
NOTES_STORE_LOCATION=./data/notes
IMAGE_STORE_LOCATION=./data/images